# Spring Boot API (no trailing slash). Required for production / Play Store builds.
# Examples:
#   VITE_API_BASE_URL=https://your-api.run.app
#   VITE_API_BASE_URL=http://10.0.2.2:8080
VITE_API_BASE_URL=http://localhost:8080

# Demo MP4 loops under public/feeds/ — omitted from production dist by default (Play 200 MB base-module limit).
# Dev: default on. Set false to test gradient-only feed.
# VITE_INCLUDE_FEED_MP4=false
# Rare: ship MP4s in AAB (large). Build with VITE_INCLUDE_FEED_MP4=true and VITE_KEEP_FEED_MP4_IN_DIST=true
# VITE_INCLUDE_FEED_MP4=true
# VITE_KEEP_FEED_MP4_IN_DIST=true
